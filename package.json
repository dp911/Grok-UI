{
  "name": "grok-ui",
  "version": "0.4.1",
  "description": "A local-first command center and live dashboard for Grok Build.",
  "private": true,
  "license": "MIT",
  "author": "Grok UI contributors",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/joeynyc/Grok-UI.git"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,ui -c green,cyan \"tsx watch server/index.ts\" \"vite\"",
    "build": "tsc -b && vite build && tsc -p tsconfig.server.json",
    "start": "node dist-server/index.js",
    "check": "tsc -b --pretty false && tsc -p tsconfig.server.json --pretty false",
    "test": "vitest run",
    "verify": "npm run check && npm test && npm run build"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.3.0",
    "@fontsource-variable/syne": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "chokidar": "^5.0.0",
    "express": "^5.2.1",
    "lucide-react": "^1.26.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^9.2.0",
    "tsx": "^4.20.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^3.2.0"
  }
}
